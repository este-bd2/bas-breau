---
// Etoiles — le classement de la maison, en or champagne.
// Le nombre vient de `etablissement.etoiles`, jamais d'une valeur écrite ici :
// le classement hôtelier est délivré par Atout France, il ne se décide pas dans
// un composant d'affichage.
import { etablissement } from '../data/site';

const { clair = false } = Astro.props;
const nombre = etablissement.etoiles;
const intitule = `Hôtel classé ${nombre} étoiles`;
---

<span
  class:list={['etoiles', clair && 'etoiles--clair']}
  role="img"
  aria-label={intitule}
  title={intitule}
>
  {Array.from({ length: nombre }, (_, i) => (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8-6.1-3.5-6.1 3.5 1.4-6.8L2.2 9.1l6.9-.8z" />
    </svg>
  ))}
</span>

---
// Etoiles — les cinq étoiles de la maison, en or champagne.
const { clair = false } = Astro.props;
---

<span
  class:list={['etoiles', clair && 'etoiles--clair']}
  role="img"
  aria-label="Hôtel classé 5 étoiles"
  title="Hôtel classé 5 étoiles"
>
  {[0, 1, 2, 3, 4].map((i) => (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8-6.1-3.5-6.1 3.5 1.4-6.8L2.2 9.1l6.9-.8z" />
    </svg>
  ))}
</span>
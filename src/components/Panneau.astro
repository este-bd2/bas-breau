---
// Panneau — photo dans son passe-partout avec légende, usuels PR multi-widths.
// Servi en AVIF + WebP via <picture>, poids calibré, loading/priority pilotables.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  legende?: string;
  largeurs?: number[];
  tailles?: string;
  prioritaire?: boolean;
  paresseuse?: boolean;
  hauteurClassique?: boolean;
}

const {
  src,
  alt,
  legende = undefined,
  largeurs = [480, 860, 1280],
  tailles = '(max-width: 700px) 92vw, 600px',
  prioritaire = false,
  paresseuse = false
} = Astro.props;
---

<figure class="panneau">
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={largeurs}
    sizes={tailles}
    loading={prioritaire ? 'eager' : paresseuse ? 'lazy' : 'eager'}
    fetchpriority={prioritaire ? 'high' : undefined}
    width={src.width}
    height={src.height}
  />
  {/* Une légende n'apparaît que si elle est fournie. */}
  {legende && <figcaption class="panneau__legende">{legende}</figcaption>}
</figure>
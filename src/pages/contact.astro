---
// Contact — coordonnées réelles, formulaire sans JavaScript (POST natif vers
// api/contact.mjs), consentement, FAQ.
import Canevas from '../layouts/Canevas.astro';
import Escalier from '../components/Escalier.astro';
import Voile from '../components/Voile.astro';
import Appel from '../components/Appel.astro';
import { FORMULAIRE, FAQ } from '../data/contact';
import { etablissement } from '../data/site';

// Les trois motifs d'échec renvoyés par api/contact.mjs. Ils sont tous rendus
// dans la page, masqués, et révélés par :target. Une page statique ne peut pas
// lire Astro.props — qui reste vide au prérendu, et laissait donc le visiteur
// devant un formulaire vide sans la moindre explication.
const ERREURS = [
  {
    code: 'validation',
    texte:
      'Le message n’a pas pu partir : vérifiez votre adresse e-mail, le message et la case de consentement.',
    appel: false
  },
  {
    code: 'config',
    texte:
      'L’envoi est momentanément indisponible et votre demande n’a pas été transmise. Merci d’appeler directement la maison au',
    appel: true
  },
  {
    code: 'envoi',
    texte:
      'L’envoi n’a pas abouti et votre demande n’a pas été transmise. Retentez, ou appelez la réception au',
    appel: true
  }
] as const;

const telephones = etablissement.contact.telephonePrincipal;

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.reponse }
    }))
  }
];
---

<Canevas
  titre="Contactez l’Hôtellerie du Bas-Bréau"
  description={`Contact direct et formulaire de demande : chambres & suites, événements, séminaires, privatisations. 22 Grande Rue, 77630 Barbizon — ${etablissement.contact.telephonePrincipal}.`}
  chemin="/contact"
  schema={schema}
>
  <Escalier
    surtitre="La réception"
    titre="Contact"
    image={undefined}
  />

  <div class="spectateur">
    <section class="tranche">
      <div class="duo">
        <div class="duo__texte">
          <Voile
            surtitre="Écrivez, appelez"
            titre="La maison vous répond"
          />
          <address class="coordees">
            <div>
              <dt>{etablissement.contact.adresse.voie}</dt>
              <dd>{etablissement.contact.adresse.ville}, {etablissement.contact.adresse.codePostal}</dd>
            </div>
            <div>
              <dt>Téléphone</dt>
              <dd>
                <a href={`tel:${etablissement.contact.telephonePrincipal.replace(/\s/g, '')}`}>{etablissement.contact.telephonePrincipal}</a>
              </dd>
            </div>
            <div>
              <dt>E-mail</dt>
              <dd>
                <a href={`mailto:${etablissement.contact.email}`}>{etablissement.contact.email}</a>
              </dd>
            </div>
          </address>
          <p class="saisie__note">{FORMULAIRE.noteRGPD}</p>
        </div>

        <form class="saisie" method="post" action="/api/contact" novalidate>
          {/* Champ leurre anti-robot — il reste invisible aux humains */}
          <p class="leurre-declare" aria-hidden="true">
            <label>
              Ne pas remplir ce champ
              <input type="text" name="chambres_detail" value="" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          {ERREURS.map((e) => (
            <p class="saisie__erreur" id={`erreur-${e.code}`} role="alert">
              {e.texte}
              {e.appel && (
                <> <a href={`tel:${telephones.replace(/\s/g, '')}`}>{telephones}</a>.</>
              )}
            </p>
          ))}

          <label class="saisie__champ">
            <span>Nom</span>
            <input type="text" name="nom" required autocomplete="name" />
          </label>

          <label class="saisie__champ">
            <span>Adresse e-mail</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="saisie__champ">
            <span>Téléphone (facultatif)</span>
            <input type="tel" name="telephone" autocomplete="tel" />
          </label>

          <label class="saisie__champ">
            <span>Votre demande</span>
            <select name="motif">
              {FORMULAIRE.motif.map((m) => (
                <option value={m.valeur}>{m.libelle}</option>
              ))}
            </select>
          </label>

          <label class="saisie__champ">
            <span>Message</span>
            <textarea name="message" rows="7" required></textarea>
          </label>

          <label class="saisie__accord">
            <input type="checkbox" name="consentement" value="oui" required />
            <span>{FORMULAIRE.consentement}</span>
          </label>

          <button class="bouton bouton--sienne" type="submit">
            Envoyer la demande
          </button>
        </form>
      </div>
    </section>

    <section class="tranche tranche--ton-papier">
      <Voile
        surtitre="Questions fréquentes"
        titre="Réponses rapides"
      />
      <div class="questions">
        {FAQ.map((f) => (
          <details class="question">
            <summary>{f.question}</summary>
            <p>{f.reponse}</p>
          </details>
        ))}
      </div>
    </section>

    <Appel
      titre="Traiter avec la maison"
      texte="Pour une réservation immédiate, le moteur officiel est le plus rapide."
      bouton={{
        libelle: 'Réserver en ligne',
        href: etablissement.moteurReservation,
        externe: true
      }}
    />
  </div>
</Canevas>

<script>
  /* Conservation de la saisie en cas d'échec d'envoi.
     sessionStorage reste dans le navigateur du visiteur : rien ne part dans
     l'URL, rien n'entre dans les journaux du serveur, rien ne fuit par l'en-tête
     Referer. Sans JavaScript le formulaire fonctionne quand même — seule la
     restitution du texte est perdue, jamais l'envoi ni le message d'erreur. */
  const form = document.querySelector('form.saisie');
  if (form instanceof HTMLFormElement) {
    const CLE = 'bas-breau:contact';
    const champs = ['nom', 'email', 'telephone', 'motif', 'message'];

    form.addEventListener('submit', () => {
      const donnees = {};
      for (const nom of champs) {
        const champ = form.elements.namedItem(nom);
        if (champ && 'value' in champ) donnees[nom] = champ.value;
      }
      try {
        sessionStorage.setItem(CLE, JSON.stringify(donnees));
      } catch {}
    });

    if (location.hash.startsWith('#erreur-')) {
      try {
        const donnees = JSON.parse(sessionStorage.getItem(CLE) || '{}');
        for (const [nom, valeur] of Object.entries(donnees)) {
          const champ = form.elements.namedItem(nom);
          if (champ && 'value' in champ && valeur) champ.value = valeur;
        }
      } catch {}
    } else {
      try {
        sessionStorage.removeItem(CLE);
      } catch {}
    }
  }
</script>
{
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/vcard.html", "destination": "/contact", "status": 301 },

    { "source": "/fr/chambres-et-suites.html", "destination": "/chambres-suites", "status": 301 },
    { "source": "/fr/detente-et-loisirs.html", "destination": "/detente-et-loisirs", "status": 301 },
    { "source": "/fr/galerie.htm", "destination": "/galerie", "status": 301 },
    { "source": "/fr/index.html", "destination": "/", "status": 301 },
    { "source": "/fr/my-meeting.html", "destination": "/seminaires", "status": 301 },
    { "source": "/fr/my-table.html", "destination": "/restaurant", "status": 301 },
    { "source": "/fr/philosophie-et-histoire.html", "destination": "/histoire", "status": 301 },
    { "source": "/fr/plandessalons.htm", "destination": "/seminaires", "status": 301 },
    { "source": "/fr/restaurant-et-bistrot.html", "destination": "/restaurant", "status": 301 },
    { "source": "/fr/restaurant.htm", "destination": "/restaurant", "status": 301 },
    { "source": "/fr/seminaires-et-receptions.html", "destination": "/seminaires", "status": 301 },
    { "source": "/fr/situation-et-acces.html", "destination": "/situation-et-acces", "status": 301 },
    { "source": "/fr/speed-search-texte.html", "destination": "/contact", "status": 301 },
    { "source": "/fr/tarifs-et-offres-speciales.html", "destination": "/tarifs", "status": 301 },
    { "source": "/fr/chambres-et-suites.php", "destination": "/chambres-suites", "status": 301 },
    { "source": "/fr/detente-et-loisirs.php", "destination": "/detente-et-loisirs", "status": 301 },

    { "source": "/fr/restaurant-et-bistrot.php", "destination": "/restaurant", "status": 301 },
    { "source": "/fr/seminaires-et-receptions.php", "destination": "/seminaires", "status": 301 },
    { "source": "/fr/situation-et-acces.php", "destination": "/situation-et-acces", "status": 301 },
    { "source": "/fr/speed-search-texte.php", "destination": "/contact", "status": 301 },
    { "source": "/fr/tarifs-et-offres-speciales.php", "destination": "/tarifs", "status": 301 },

    { "source": "/uk/chambres-et-suites.html", "destination": "/chambres-suites", "status": 301 },
